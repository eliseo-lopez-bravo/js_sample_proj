pipeline {
    agent any
    environment {
	NEW_VERSION = '1.3.0'
//	SERVER_CREDENTIALS = credentials('server-credentials')

    }
    tools {
		ant 'Ant'
    }
    stages {
        stage('Build') {
//          when {
//		expression {
//			BRANCH_NAME == 'dev' && CODE_CHANGES == true // run only if branch is dev or main
//		}
//          }

            steps {
		echo "Building Application!!!???"
		echo "Building version ${NEW_VERSION}"
		sh "ant package"

            }
        }        
        stage('Test') {
            when {
		expression {
			BRANCH_NAME == 'dev' || BRANCH_NAME == 'main'  // run only if branch is dev or main
//			BRANCH_NAME == 'dev'
		}
            }
            steps {
		echo "Testing Application!!!???"
            }
        } 
        stage('Deploy') {
            steps {
		echo "Deploying Application!!!???"
//		echo "Deploying with ${SERVER_CREDENTIALS}"
		withCredentials([
			usernamePassword(credentialsId: 'server-credentials', usernameVariable: 'USER', passwordVariable: 'PWD')
		]){
			sh "echo $USER $PWD"
		}
            }
        }
    }
    post {
	always{
		echo "always execute this task!!"
	}
	success{
		echo "only execute this task if successful!!" // this could be an email with build status
	}
	failure{
		echo "only execute this task if failure!!" // this could be an email with build status and perform clean up
	}
    }
}
